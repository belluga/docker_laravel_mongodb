server {
    listen 80;
    listen [::]:80;
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name _;

    ssl_certificate /etc/nginx/certs/local/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/local/privkey.pem;

    client_max_body_size 100M;

    root /var/www/public;
    index index.php index.html;
    try_files $uri $uri/ /index.php?$query_string;

    location = /.well-known/assetlinks.json {
        default_type application/json;
        try_files $uri /index.php?$query_string;
    }

    location = /.well-known/apple-app-site-association {
        default_type application/json;
        try_files $uri /index.php?$query_string;
    }

    location @laravel {
        rewrite ^ /index.php$is_args$args last;
    }

    location @tenant_public_shell {
        rewrite ^ /index.php$is_args$args last;
    }

    location = /index.html {
        root /opt/web-shell;
        try_files $uri =404;
        add_header Cache-Control "no-cache" always;
    }

    location = /main.dart.js {
        root /opt/web-shell;
        try_files $uri =404;
        add_header Cache-Control "no-cache" always;
    }

    location = /flutter_bootstrap.js {
        root /opt/web-shell;
        try_files $uri =404;
        add_header Cache-Control "no-cache" always;
    }

    location = /flutter_service_worker.js {
        root /opt/web-shell;
        try_files $uri =404;
        add_header Cache-Control "no-cache" always;
    }

    location = /build_metadata.json {
        root /opt/web-shell;
        try_files $uri =404;
        add_header Cache-Control "no-cache" always;
    }

    location = /version.json {
        root /opt/web-shell;
        try_files $uri =404;
        add_header Cache-Control "no-cache" always;
    }

    # Tenant-aware branding assets are backend-owned even though they look file-like.
    location = /manifest.json {
        error_page 404 = /__web_shell_placeholder_manifest;
        try_files /__backend_owned_branding__ /index.php?$query_string;
    }

    location = /favicon.ico {
        error_page 404 = /__web_shell_placeholder_favicon;
        try_files /__backend_owned_branding__ /index.php?$query_string;
    }

    location ^~ /icon/ {
        error_page 404 = /__web_shell_placeholder_icon;
        try_files /__backend_owned_branding__ /index.php?$query_string;
    }

    location = /logo-dark.png {
        error_page 404 = /__web_shell_placeholder_logo_dark;
        try_files /__backend_owned_branding__ /index.php?$query_string;
    }

    location = /logo-light.png {
        error_page 404 = /__web_shell_placeholder_logo_light;
        try_files /__backend_owned_branding__ /index.php?$query_string;
    }

    location = /icon-dark.png {
        error_page 404 = /__web_shell_placeholder_icon_dark;
        try_files /__backend_owned_branding__ /index.php?$query_string;
    }

    location = /icon-light.png {
        error_page 404 = /__web_shell_placeholder_icon_light;
        try_files /__backend_owned_branding__ /index.php?$query_string;
    }

    location = /__web_shell_placeholder_manifest {
        internal;
        root /opt/web-shell;
        try_files /web-manifest.json =404;
        add_header Cache-Control "no-cache" always;
    }

    location = /__web_shell_placeholder_favicon {
        internal;
        root /opt/web-shell;
        try_files /favicon.png =404;
        add_header Cache-Control "no-cache" always;
    }

    location = /__web_shell_placeholder_icon {
        internal;
        root /opt/web-shell;
        try_files /favicon.png =404;
        add_header Cache-Control "no-cache" always;
    }

    location = /__web_shell_placeholder_logo_dark {
        internal;
        root /opt/web-shell;
        try_files /splash/img/dark-4x.png =404;
        add_header Cache-Control "no-cache" always;
    }

    location = /__web_shell_placeholder_logo_light {
        internal;
        root /opt/web-shell;
        try_files /splash/img/light-4x.png =404;
        add_header Cache-Control "no-cache" always;
    }

    location = /__web_shell_placeholder_icon_dark {
        internal;
        root /opt/web-shell;
        try_files /favicon.png =404;
        add_header Cache-Control "no-cache" always;
    }

    location = /__web_shell_placeholder_icon_light {
        internal;
        root /opt/web-shell;
        try_files /favicon.png =404;
        add_header Cache-Control "no-cache" always;
    }

    location ^~ /assets/ {
        root /opt/web-shell;
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable" always;
    }

    location ~* \.(?:js|css|png|jpg|jpeg|gif|svg|webp|json|map|wasm|txt)$ {
        root /opt/web-shell;
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable" always;
    }

    location ^~ /storage/ {
        alias /var/www/storage/app/public/;
        expires 1y;
        add_header Cache-Control "public";
        add_header X-Content-Type-Options nosniff;
        add_header X-Frame-Options DENY;
    }

    location = / {
        try_files /__tenant_public_shell__ /index.php?$query_string;
    }

    include /etc/nginx/project/*.conf;

    location ^~ /api/ {
        try_files $uri /index.php?$query_string;
    }

    location = /admin/api {
        try_files $uri /index.php?$query_string;
    }

    location ^~ /admin/api/ {
        try_files $uri /index.php?$query_string;
    }

    location = /admin {
        root /opt/web-shell;
        try_files /index.html =404;
        add_header Cache-Control "no-cache" always;
    }

    location ^~ /admin/ {
        root /opt/web-shell;
        try_files /index.html =404;
        add_header Cache-Control "no-cache" always;
    }

    location / {
        root /opt/web-shell;
        try_files $uri $uri/ /index.html;
    }

    location ~ \.php$ {
        try_files $uri =404;
        include fastcgi_params;
        fastcgi_pass app:9000;
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param PATH_INFO $fastcgi_path_info;

        set $forwarded_proto $http_x_forwarded_proto;
        if ($forwarded_proto = '') {
            set $forwarded_proto $scheme;
        }
        if ($http_cf_visitor ~* "\"scheme\":\"https\"") {
            set $forwarded_proto https;
        }
        if ($http_cf_visitor ~* "\"scheme\":\"http\"") {
            set $forwarded_proto http;
        }
        fastcgi_param HTTP_X_FORWARDED_PROTO $forwarded_proto;

        set $fastcgi_https '';
        set $fastcgi_server_port $server_port;
        if ($forwarded_proto = 'https') {
            set $fastcgi_https 'on';
            set $fastcgi_server_port 443;
        }
        fastcgi_param HTTPS $fastcgi_https;
        fastcgi_param REQUEST_SCHEME $forwarded_proto;
        fastcgi_param SERVER_PORT $fastcgi_server_port;

        fastcgi_read_timeout 300;
        fastcgi_send_timeout 300;
    }

    location ~ /\. {
        deny all;
    }

    location ~ /(vendor|storage|bootstrap|config|database|resources|routes|tests)/ {
        deny all;
    }

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml text/javascript application/javascript application/xml+rss application/json;
}
